ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional per-surface override. Defaults to the fast Haiku model when empty.
LUME_AI_MODEL=claude-haiku-4-5-20251001
# Keep the guide responsive when the provider is unavailable.
LUME_AI_TIMEOUT_MS=20000
# Optional server-to-server VOLYNX gateway. When both are set, PDU routes
# use the gateway's provider/model and do not call Anthropic directly.
PDU_AI_GATEWAY_URL=
PDU_AI_GATEWAY_TOKEN=

# Supabase project: https://matykrddzfjcswqjanly.supabase.co
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public app URL used by auth redirects, checkout success/cancel URLs and emails.
NEXT_PUBLIC_SITE_URL=https://palavrasdouniverso.com
NEXT_PUBLIC_SUPPORT_EMAIL=
# Optional bearer token for detailed /api/health/commerce diagnostics.
HEALTH_CHECK_TOKEN=
# Required to authorize scheduled push broadcasts.
CRON_SECRET=

# Payment provider keys for future paid readings/subscriptions.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Set true only after completing the corresponding live smoke test.
STRIPE_CHECKOUT_VERIFIED=false
STRIPE_CUSTOMER_PORTAL_VERIFIED=false

# Set true only after Pix is active in the Stripe account/payment methods.
STRIPE_ENABLE_PIX=false

# Internal-only checkout proof. Keep false in production; test mode and a non-production runtime are also required.
PDU_ENABLE_INTERNAL_TEST_CHECKOUT=false
# Temporary owner-only production smoke test. Keep false except during an approved live test.
PDU_ENABLE_INTERNAL_LIVE_CHECKOUT=false
